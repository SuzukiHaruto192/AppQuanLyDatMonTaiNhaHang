    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFE6A0B8" Offset="0"/>
            <GradientStop Color="#FFF5C4D4" Offset="0.504"/>
            <GradientStop Color="#FFF5C4D4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <TabControl>
        <TabItem Header="Hôm nay" Margin="-2,-2,-19,0" Foreground="#FF020202" OpacityMask="#FFAF5C5C" FontFamily="Arial Rounded MT Bold" FontSize="14" BorderBrush="{x:Null}">
            <TabItem.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF2A8C2"/>
                    <GradientStop Color="#FFF5C1D3" Offset="1"/>
                </LinearGradientBrush>
            </TabItem.Background>
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="25*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="239*"/>
                    <ColumnDefinition Width="158*"/>
                </Grid.ColumnDefinitions>
                <lvc:PieChart Grid.Column="0" LegendLocation="Right" Margin="76,30,75,8" Series="{Binding MyPieChartCollection}" Grid.Row="1" />
                <Border BorderBrush="Black" BorderThickness="1" Margin="26,16,251,4" CornerRadius="10,10,10,10">
                    <TextBlock TextWrapping="Wrap" Text="{Binding RevenueOfDay}" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="16"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Margin="302,16,51,4" CornerRadius="10,10,10,10">
                    <TextBlock TextWrapping="Wrap" Text="{Binding OrdersOfDay}" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="16"/>
                </Border>
                <ItemsControl Margin="1,41,1,118" ItemsSource="{Binding BestSellerItems}" RenderTransformOrigin="0.5,0.5" Grid.Column="1" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,10" CornerRadius="10,10,10,10">
                                <StackPanel Orientation="Horizontal" Margin="10" >
                                    <TextBlock Text="{Binding TenMon}" FontFamily="Arial Rounded MT Bold" FontSize="10" Width="150"/>
                                    <TextBlock Text="{Binding SoLuong}" FontFamily="Arial Rounded MT Bold" FontSize="10" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding TongDoanhThu, StringFormat=N0}" FontFamily="Arial Rounded MT Bold" FontSize="10" Width="100" TextAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Label Grid.Column="1" Content="Best seller :" HorizontalAlignment="Left" Margin="1,8,0,0" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" Grid.Row="1" Height="26" Width="90"/>
                <DatePicker Style="{DynamicResource MyDatePicker}" x:Name="dpDate" Grid.Column="1" HorizontalAlignment="Left" 
                            Margin="135,22,0,0" VerticalAlignment="Top" Width="164" 
                            SelectedDateChanged="DatePicker_SelectedDateChanged" />
            </Grid>
        </TabItem>
        <TabItem Style="{DynamicResource TabControlMyStyle}" Header="Tháng" Margin="19,-2,-45,0" FontFamily="Arial Rounded MT Bold" FontSize="14" BorderBrush="{x:Null}">
            <TabItem.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF2A8C2"/>
                    <GradientStop Color="#FFF5C1D3" Offset="1"/>
                </LinearGradientBrush>
            </TabItem.Background>
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="53*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Grid.RowSpan="2">
                    <lvc:CartesianChart Series="{Binding MySeriesCollection}" LegendLocation="Bottom" Margin="14,65,23,12" >
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="{Binding TitleChart}" Labels="{Binding MyLabels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator IsEnabled="False"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>

                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Doanh thu (VNĐ)" LabelFormatter="{Binding MyFormatterRevenue}" />
                            <lvc:Axis Title="Số đơn hàng"
                                        Foreground="Blue"
                                        Position="RightTop"
                                        LabelFormatter="{Binding MyFormatterOrders}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>

                <TextBlock HorizontalAlignment="Left"  TextWrapping="Wrap" Text="Năm:" Margin="162,9,0,6" />
                <ComboBox Style="{DynamicResource MyComboBox}" HorizontalAlignment="Left"  
                              Width="114" VerticalContentAlignment="Stretch" 
                              AllowDrop="True" 
                              HorizontalContentAlignment="Center" 
                              Margin="215,5,0,3" 
                              Name="cbxYear"
                              SelectionChanged="cbxYear_SelectionChanged"
                              ItemsSource="{Binding Years}"
                              />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
