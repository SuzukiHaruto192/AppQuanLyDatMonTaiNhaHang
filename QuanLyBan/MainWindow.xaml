<Window x:Class="QuanLyBan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBan"
        mc:Ignorable="d"
        Title="Quản Lý Nhà Hàng" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
        x:Name="Sidebar"
        Width="50" 
        HorizontalAlignment="Left"
        ClipToBounds="True"
        Panel.ZIndex="100">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="20" Opacity="0.25" Direction="0"/>
            </Border.Effect>

            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#F37335" Offset="0"/>
                    <GradientStop Color="#BF2807" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.3" AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="50" Duration="0:0:0.3" AccelerationRatio="0.2" DecelerationRatio="0.8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Border HorizontalAlignment="Right" Width="1" VerticalAlignment="Stretch" SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Left" Width="50" Background="Transparent">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" 
                        FontSize="22" Foreground="White" 
                        HorizontalAlignment="Center" Margin="0,43,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="60,25,10,0">
                    <TextBlock Text="ĐIỀU HƯỚNG" FontSize="11" FontWeight="Bold" Opacity="0.6" Foreground="White" Margin="5,0,0,5"/>

                    <ComboBox x:Name="cbbNavigation"
                        SelectionChanged="cbbNavigation_SelectionChanged"
                        SelectedIndex="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Padding="10">

                        <ComboBox.Resources>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="SnapsToDevicePixels" Value="true"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ComboBox}">
                                            <Grid>
                                                <ToggleButton Name="ToggleButton" Grid.Column="2" 
                                                              Focusable="false" 
                                                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                                              ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                                  Margin="0,0,30,0" VerticalAlignment="Center" 
                                                                  HorizontalAlignment="Left" />
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                    <Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border x:Name="DropDownBorder" Background="White" BorderThickness="0" CornerRadius="8" Margin="0,5,0,0">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="5" Color="Black"/>
                                                            </Border.Effect>
                                                            <ScrollViewer Margin="0,5" SnapsToDevicePixels="True">
                                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#444"/>
                                
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="6" Margin="2,1" 
                                                    SnapsToDevicePixels="true">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFF5EB"/>
                                                    <Setter Property="Foreground" Value="#BF2807"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFE0C2"/>
                                                    <Setter Property="Foreground" Value="#BF2807"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>

                        <ComboBoxItem Tag="QuanLyBan">
                            <TextBlock Text="QUẢN LÝ BÀN" VerticalAlignment="Center"/>
                        </ComboBoxItem>

                        <ComboBoxItem Tag="QuanLyMenu">
                            <TextBlock Text="QUẢN LÝ MENU" VerticalAlignment="Center"/>
                        </ComboBoxItem>

                        <ComboBoxItem Tag="ThongKe">
                            <TextBlock Text="THỐNG KÊ" VerticalAlignment="Center"/>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" x:Name="MainContent" Margin="0"/>
    </Grid>
</Window>