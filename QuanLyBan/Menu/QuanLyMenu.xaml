<Window x:Class="QuanLyBan.QuanLyMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBan"
        mc:Ignorable="d"
        Title="QuanLyMenu" Height="450" Width="800">
    <Window.Resources>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:StatusToTextConverter x:Key="StatusToTextConverter"/>

        <Color x:Key="PrimaryOrangeColor">#FF8E2B</Color>
        <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="{StaticResource PrimaryOrangeColor}"/>

        <Style TargetType="ListView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF7A00"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#EEE"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#AAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="Txtblockstyle">
            <Setter Property ="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF7A00" Offset="0.0"/>
                        <GradientStop Color="#FFC300" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" Color="#FF7A00" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="BorderBrush" Value="#FF7A00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFA500"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC6600"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" 
                               Background="{TemplateBinding Background}" 
                               CornerRadius="10" 
                               SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Tag}" 
                                          FontFamily="Segoe MDL2 Assets" 
                                          FontSize="18" 
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,15,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryOrangeBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="TableContainerStyle">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="10" Color="#CCC" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryOrangeBrush}"/>
                    <Setter Property="BorderThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Background>
        <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4"
                         RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#505050" Offset="0" />
            <GradientStop Color="#101010" Offset="0.5" />
            <GradientStop Color="#000000" Offset="1" />
        </RadialGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="0,12,12,0" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8E2B" Offset="0"/>
                    <GradientStop Color="#FF7010" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="cbbNavigation"
          SelectedIndex="1"
          SelectionChanged="cbbNavigation_SelectionChanged"
          Background="Transparent"
          BorderThickness="0"
          Foreground="White"
          FontSize="22"
          FontWeight="Bold"
          VerticalAlignment="Center"
          Cursor="Hand">

                    <ComboBox.Resources>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="SnapsToDevicePixels" Value="true"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBox}">
                                        <Grid>
                                            <ToggleButton Name="ToggleButton" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="0,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" 
                                       IsHitTestVisible="False"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0"/>

                                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                                <Grid Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderThickness="1"
                                            BorderBrush="#DDD"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
                                                        </Border.Effect>
                                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                                <Setter Property="Foreground" Value="#FF8E2B"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFF0E0"/>
                                                <Setter Property="Foreground" Value="#FF8E2B"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>

                    <ComboBoxItem Tag="QuanLyBan">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="QUẢN LÝ BÀN" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="QuanLyMenu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="QUẢN LÝ MENU" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>

                </ComboBox>

                <StackPanel Grid.Row="1" x:Name="FilterButtons">
                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup" IsChecked="True"
                                Tag="&#xE825;" Content="Tất cả bàn"
                                Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Tất cả bàn"/>

                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup"
                                Tag="&#xE73B;" Content="Bàn trống"
                                Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Bàn trống"/>

                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup"
                                Tag="&#xE716;" Content="Đang phục vụ"
                                Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Đang phục vụ"/>

                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup"
                                Tag="&#xE77B;" Content="Đã đặt trước"
                                Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Đã đặt trước"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="15,0,15,15">

                    <Border Background="White" CornerRadius="12" Padding="20" Height="200" Opacity="0.2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DSBan.SelectedTable}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chọn bàn để xem" Foreground="Black" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DSBan.SelectedTable}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="5" BlurRadius="20" Color="Black" Opacity="0.15"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="CHI TIẾT BÀN" FontSize="12" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding DSBan.SelectedTable.TableNumber}" 
                                          FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryOrangeBrush}" DockPanel.Dock="Left"/>
                                <Border Background="{Binding DSBan.SelectedTable.Status, Converter={StaticResource StatusToColorConverter}}" CornerRadius="4" Padding="8,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DSBan.SelectedTable.Status, Converter={StaticResource StatusToTextConverter}}" 
                                              Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>

                            <Separator Margin="0,10" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBlock Text="Sức chứa:" Foreground="#555" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding DSBan.SelectedTable.Capacity}" FontWeight="Bold" Foreground="#333" Margin="5,0,0,0"/>
                                <TextBlock Text="người" Foreground="#555" Margin="3,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="10" RenderTransformOrigin="0.494,0.46">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>
            <!-- Khu nhập thông tin -->
            <Border DockPanel.Dock="Top"
                Margin="20"
                Padding="20,20,20,0"
                Background="White"
                CornerRadius="15"
                BorderBrush="#DDD"
                BorderThickness="1"
                Effect="{DynamicResource DropShadow}">
                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Opacity="0.3"/>
                </Border.Resources>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="Tên món:" Style ="{StaticResource Txtblockstyle}"/>
                    <TextBox x:Name="txtTenMon" Margin="0,0,0,8"/>


                    <TextBlock Text="Giá (VNĐ):" Style ="{StaticResource Txtblockstyle}"/>
                    <TextBox x:Name="txtGia" Margin="0,0,0,8"/>

                    <TextBlock Text="Hình ảnh:" Style ="{StaticResource Txtblockstyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtHinh" Width="350" Margin="0,0,10,0"/>
                        <Button Content="Chọn ảnh..." Click="ChonAnh_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Thêm món" Click="ThemMon_Click" Margin="0,0,10,0"/>
                        <Button Content="Xóa món" Click="XoaMon_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Danh sách món -->
            <ListView x:Name="lstMon" Grid.Row="1" 
                  ItemsSource="{Binding DanhSachMon}" 
                  Background="Transparent"
                  BorderThickness="0">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="240"
                            Margin="10"
                            CornerRadius="12"
                            Background="White"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            Effect="{DynamicResource DropShadow}">
                            <Border.Resources>
                                <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                            </Border.Resources>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#FF7A00"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <Image Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"
                                   Width="160" Height="140"
                                   Margin="10,10,10,5"
                                   Stretch="UniformToFill"
                                   ClipToBounds="True"
                                   SnapsToDevicePixels="True"
                                   />


                                <TextBlock Text="{Binding Ten}"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="#333"
                                       TextAlignment="Center"
                                       Margin="5,5,5,2"
                                       TextWrapping="Wrap" />

                                <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} VNĐ}"
                                       Margin="5,2,5,3"
                                       FontSize="16"
                                       Foreground="#FF7A00"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
