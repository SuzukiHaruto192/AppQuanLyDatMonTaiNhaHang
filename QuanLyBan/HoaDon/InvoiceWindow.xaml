<Window x:Class="QuanLyBan.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBan"
        mc:Ignorable="d"
        Title="Hóa đơn Thanh toán" 
        WindowStartupLocation="CenterOwner"
        Width="460" Height="550"
        Background="#F9F9F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="20,4,0,4"/>
        </Style>

        <Style x:Key="TotalLabel" TargetType="TextBlock" BasedOn="{StaticResource SummaryLabel}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000"/>
        </Style>
        <Style x:Key="TotalValue" TargetType="TextBlock" BasedOn="{StaticResource SummaryValue}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="ForestGreen"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuantityTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#007ACC">
                <Run Text="Bàn số: "/>
                <Run Text="{Binding TableToBill.TableNumber}"/>
            </TextBlock>
            <StackPanel>
                <TextBlock FontSize="13" Foreground="#777" Margin="0,5,0,0">
                <Run Text="Mã HD:"/>
                <Run Text="{Binding InvoiceID}"/>
                </TextBlock>
                <TextBlock FontSize="13" Foreground="#777" Margin="0,5,0,0">
                <Run Text="Thời gian:"/>
                <Run Text="{Binding InvoiceDate}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding Items}"
                  BorderThickness="1" BorderBrush="#DDD"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Tên món" Width="160"
                                    DisplayMemberBinding="{Binding ItemName}"/>
                    <GridViewColumn Header="SL" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Quantity}" 
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding DataContext.IsReadOnly, 
                                                        RelativeSource={RelativeSource AncestorType=ListView}, 
                                                        Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         HorizontalAlignment="Center"
                                         Style="{StaticResource QuantityTextBoxStyle}"
                                         Visibility="{Binding DataContext.IsEditing,
                                                     RelativeSource={RelativeSource AncestorType=ListView},
                                                     Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Đơn giá" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Thành tiền" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Total, StringFormat={}{0:N0}}" TextAlignment="Right" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn  Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X"
                                        Foreground="Red"
                                        FontWeight="SemiBold"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding DataContext.IsEditing,
                                                    RelativeSource={RelativeSource AncestorType=ListView},
                                                    Converter={StaticResource BoolToVis}}"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="2" Margin="0,15,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tạm tính:" Style="{StaticResource SummaryLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:N0} VNĐ}" Style="{StaticResource SummaryValue}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Giảm giá:" Style="{StaticResource SummaryLabel}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountAmount, StringFormat=-{0:N0} VNĐ}" Style="{StaticResource SummaryValue}" Foreground="Red"/>

            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width ="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding EditButtonText}"
                        Width="80" Height="25"
                        FontSize="16" FontWeight="Bold"
                        Padding="0,12"
                        Background="#007ACC"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding EditModeCommand}"/>
                <TextBlock Grid.Column = "1" Text= "TỔNG CỘNG:" Style="{StaticResource TotalLabel}" />
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:N0} VNĐ}" Style="{StaticResource TotalValue}"/>
        </Grid>

        <Button x:Name="ConfirmPaymentButton" 
                Grid.Row="3"
                Content="Xác nhận Thanh toán" 
                Padding="0,12" FontSize="16" FontWeight="Bold"
                Style="{StaticResource ActionButtonStyle}"
                Background="ForestGreen"
                IsEnabled="False"
                Click="ConfirmPaymentButton_Click"/>
    </Grid>
</Window>