<UserControl x:Class="QuanLyBan.UcBan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyBan"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:StatusToTextConverter x:Key="StatusToTextConverter"/>

        <Color x:Key="PrimaryOrangeColor">#FF8E2B</Color>
        <SolidColorBrush x:Key="PrimaryOrangeBrush" Color="{StaticResource PrimaryOrangeColor}"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="10" 
                            SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Tag}" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="18" 
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" 
                                       Margin="0,0,15,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryOrangeBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="TableContainerStyle">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="10" Color="#CCC" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryOrangeBrush}"/>
                    <Setter Property="BorderThickness" Value="4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="0,12,12,0" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8E2B" Offset="0"/>
                    <GradientStop Color="#FF7010" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,0,0,25">
                    <TextBlock Text="QUẢN LÝ BÀN" FontSize="22" FontWeight="Bold" Foreground="White" Margin="10,0,0,0"/>
                    <TextBlock Text="Hệ thống nhà hàng" FontSize="12" Foreground="#CCFFFFFF" Margin="20,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" x:Name="FilterButtons">
                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup" IsChecked="True"
                             Tag="&#xE825;" Content="Tất cả bàn"
                             Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Tất cả bàn"/>

                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup"
                             Tag="&#xE73B;" Content="Bàn trống"
                             Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Bàn trống"/>

                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup"
                             Tag="&#xE716;" Content="Đang phục vụ"
                             Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Đang phục vụ"/>

                    <RadioButton Style="{StaticResource MenuRadioButtonStyle}" GroupName="FilterGroup"
                             Tag="&#xE77B;" Content="Đã đặt trước"
                             Command="{Binding DSBan.FilterTableCommand}" CommandParameter="Đã đặt trước"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="15,0,15,15">

                    <Border Background="White" CornerRadius="12" Padding="20" Height="200" Opacity="0.2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DSBan.SelectedTable}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chọn bàn để xem" Foreground="Black" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DSBan.SelectedTable}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="5" BlurRadius="20" Color="Black" Opacity="0.15"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="CHI TIẾT BÀN" FontSize="12" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding DSBan.SelectedTable.TableNumber}" 
                                       FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryOrangeBrush}" DockPanel.Dock="Left"/>
                                <Border Background="{Binding DSBan.SelectedTable.Status, Converter={StaticResource StatusToColorConverter}}" CornerRadius="4" Padding="8,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DSBan.SelectedTable.Status, Converter={StaticResource StatusToTextConverter}}" 
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>

                            <Separator Margin="0,10" Background="#EEE"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBlock Text="Sức chứa:" Foreground="#555" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding DSBan.SelectedTable.Capacity}" FontWeight="Bold" Foreground="#333" Margin="5,0,0,0"/>
                                <TextBlock Text="người" Foreground="#555" Margin="3,0,0,0"/>
                                <Button Content="Đặt trước" Style="{StaticResource ActionButtonStyle}" Background="Red" Margin="20,0,0,0" FontWeight="SemiBold" Width="80" HorizontalContentAlignment="Center" 
                                     Command="{Binding DSBan.BookTableCommand}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Phục vụ" Style="{StaticResource ActionButtonStyle}" Background="#28A745"
                                    Command="{Binding DSBan.ServeTableCommand}"/>
                                <Button Grid.Column="2" Content="Thanh toán" Style="{StaticResource ActionButtonStyle}" Background="#007ACC"
                                    Command="{Binding DSBan.ClearTableCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White"  Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Danh sách bàn" FontSize="24" FontWeight="SemiBold" Foreground="#333" Margin="30,25,0,10"/>

                <ListBox Grid.Row="1" 
                     ItemsSource="{Binding DSBan.Tables}"
                     SelectedItem="{Binding DSBan.SelectedTable, Mode=TwoWay}" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" 
                     Background="Transparent"
                     Margin="20,0,20,20">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TableContainerStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding TableNumber}" 
                                               Foreground="White" FontSize="36" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock Text="&#x1F464;" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Capacity}" 
                                                   Foreground="White" FontSize="16" FontWeight="SemiBold" 
                                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text=" chỗ" Foreground="White" FontSize="16" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
