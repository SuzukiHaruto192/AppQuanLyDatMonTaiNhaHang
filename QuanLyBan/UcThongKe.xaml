<UserControl x:Class="QuanLyBan.UcThongKe"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyBan"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="White"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinHeight="400"
             MinWidth="700">
    <materialDesign:Card Background="{DynamicResource MaterialDesignPaper}" UniformCornerRadius="15"  materialDesign:ElevationAssist.Elevation="Dp4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="67*"/>
                <RowDefinition Height="556*"/>
                <RowDefinition Height="27*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <materialDesign:ColorZone Grid.Column="0" CornerRadius="15 0 0 15" Background="White" Margin="0,0,0,-50" VerticalAlignment="Stretch" Grid.RowSpan="3" >
                <StackPanel Margin="15">
                    <WrapPanel Margin="0 10 5 60 " HorizontalAlignment="Center">
                        <TextBlock Text="Thống kê" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 0 0"/>
                    </WrapPanel>
                    <Button x:Name="btnDayly" Click="btnDayly_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" materialDesign:ButtonAssist.CornerRadius="6" Width="auto"
                           Height="35" materialDesign:RippleAssist.Feedback="White" Margin="0 0 0 15">
                        <WrapPanel Width="120">
                            <materialDesign:PackIcon Kind="Home" VerticalAlignment="Center" Margin="0 0 20 0"/>
                            <TextBlock Text="Hàng ngày" ></TextBlock>
                        </WrapPanel>
                    </Button>
                    <Button x:Name="btnMonthly" Style="{StaticResource MaterialDesignFlatButton}" Click="btnMonthly_Click" Foreground="{DynamicResource PrimaryHueLightForegroundBrush}" materialDesign:ButtonAssist.CornerRadius="6" Width="auto"
        Height="35" materialDesign:RippleAssist.Feedback="White" Margin="0 0 0 15">
                        <WrapPanel Width="120">
                            <materialDesign:PackIcon Kind="Ballot" VerticalAlignment="Center" Margin="0 0 20 0"/>
                            <TextBlock Text="Hàng tháng" ></TextBlock>
                        </WrapPanel>
                    </Button>

                </StackPanel>
            </materialDesign:ColorZone>
            <ContentControl x:Name="MainView" Grid.Column="1" Margin="33,1,44,1" VerticalContentAlignment="Stretch" Grid.Row="1" HorizontalContentAlignment="Stretch" Width="Auto" Height="Auto" />
        </Grid>
    </materialDesign:Card>
</UserControl>
