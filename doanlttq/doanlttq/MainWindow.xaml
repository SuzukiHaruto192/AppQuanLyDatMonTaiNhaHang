<Window x:Class="doanlttq.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:doanlttq"
		mc:Ignorable="d"
		Title="ĐỒ ÁN LẬP TRÌNH TRỰC QUAN" Height="600" Width="1000">
    <Grid>

        <Grid x:Name="MenuGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Column="1"
                    Grid.Row="0"
                    Content="Khai Vị"
                    FontSize="16"
                    Foreground="Black"
                    Click="Click_Menu">
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="White"/>
                        <GradientStop Color="Black" Offset="1"/>
                        <GradientStop Color="Black" Offset="0.811"/>
                        <GradientStop Color="White" Offset="0.81"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                >
                            <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="2"
         Grid.Row="0"
         Content="Món Chính"
         FontSize="16"
         Foreground="Black"
                    Click="Click_Menu"
                    Background="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                     Background="{TemplateBinding Background}"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="3"
         Grid.Row="0"
         Content="Đồ Ăn Kèm"
         FontSize="16"
         Foreground="Black"
                    Click="Click_Menu"
                    Background="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                     Background="{TemplateBinding Background}"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="4"
         Grid.Row="0"
         Content="Nước Uống"
         FontSize="16"
         Foreground="Black"
                    Click="Click_Menu"
                    Background="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                     Background="{TemplateBinding Background}"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="5"
         Grid.Row="0"
         Content="Tráng Miệng"
         FontSize="16"
         Foreground="Black"
                    Click="Click_Menu"
                    Background="white">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                     Background="{TemplateBinding Background}"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Foods}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- Template hiển thị từng món -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" 
                                    BorderBrush="Black" 
                                    Margin="10" 
                                    Padding="10" 
                                    CornerRadius="10"
                                    Width="175"
                                    Height="200">
                                <StackPanel>
                                    <Border                                   
                                            Width="150" 
                                            Height="110"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            CornerRadius="10"
                                            BorderBrush="Black"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush  ImageSource="{Binding ImagePath}"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Price}"
                                       FontSize="14"
                                       Foreground="Black"
                                       HorizontalAlignment="Center"/>
                                    <Button Width="20"
                                            Height="20"
                                            Content="+"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="LightGreen" Click="Them_Mon">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                      Background="Gray"
                                                      BorderBrush="Black"
                                                      BorderThickness="1"
                                                    CornerRadius="5">
                                                    <ContentPresenter
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>


                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>

                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>


    </Grid>
</Window>
