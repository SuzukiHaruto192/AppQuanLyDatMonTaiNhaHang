            <ListView x:Name="lstMon" 
                      Grid.Row="1"
                      Grid.Column="1"
                  ItemsSource="{Binding Foods}"
                  Background="Transparent"
                  BorderThickness="0" SelectionChanged="lstMon_SelectionChanged"
                      >
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="240"
                            Margin="10"
                            CornerRadius="12"
                            Background="White"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            Effect="{DynamicResource DropShadow}"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.ShowDuration="10000">
                            <Border.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0" Style="{StaticResource FoodToolTipStyle}" 
             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"/>
                            </Border.ToolTip>
                            <Border.Resources>
                                <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                            </Border.Resources>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#FF7A00"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <Border                                   
        Width="160" 
        Height="140"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush  ImageSource="{Binding ANH}"/>
                                    </Border.Background>
                                </Border>


                                <TextBlock Text="{Binding TENMON}"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="#333"
                                       TextAlignment="Center"
                                       Margin="5,5,5,2"
                                       TextWrapping="Wrap" />

                                <TextBlock Text="{Binding GIA, StringFormat={}{0:N0} VNĐ}"
                                       Margin="5,2,5,3"
                                       FontSize="16"
                                       Foreground="#FF7A00"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border Grid.Row="1"
                    Grid.Column="2"
                    CornerRadius="20"
                    Background="White"
                    BorderBrush="Black"
                    Effect="{DynamicResource DropShadow}"
                    BorderThickness="2"
                >

                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                  BlurRadius="15"
                  ShadowDepth="10"
                  Direction="315"
                  Opacity="0.5"
                  RenderingBias="Quality" />
                </Border.Resources>
            </Border>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*"/>
                <ColumnDefinition Width="1.9*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.1*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="2"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Grid.Column="2"
                       Text="Giỏ Hàng"
                       FontSize="26"
                       HorizontalAlignment="Center"
                       Foreground="#FFE86106"
                       FontWeight="Bold"
                        >
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding GioHang}" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Vertical"
                                       HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate >
                            <DataTemplate >

                                <Border Width="180" Height="280"
                    Margin="10"
                    CornerRadius="12"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Effect="{DynamicResource DropShadow}">
                                    <Border.Resources>
                                        <DropShadowEffect x:Key="DropShadow"
                                      BlurRadius="8"
                                      ShadowDepth="2"
                                      Opacity="0.3" />
                                    </Border.Resources>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#FF7A00"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border                                   
        Width="160" 
        Height="140"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush  ImageSource="{Binding ANH}"/>
                                            </Border.Background>
                                        </Border>


                                        <TextBlock Text="{Binding TENMON}"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="#333"
                                       TextAlignment="Center"
                                       Margin="5,5,5,2"
                                       TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding GIA, StringFormat={}{0:N0} VNĐ}"
                                       Margin="5,2,5,3"
                                       FontSize="16"
                                       Foreground="#FF7A00"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>


                                        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
         >

                                            <!-- Giảm -->
                                            <Button Content="−"
            Style="{StaticResource QtyButtonStyle}"
            Click="Giam_SoLuong_Mon"/>

                                            <!-- Số lượng -->
                                            <TextBox Text="{Binding SoLuong}"
             Style="{StaticResource QtyTextBoxStyle}"
             Margin="6,0" LostFocus="TextBox_LostFocus"/>

                                            <!-- Tăng -->
                                            <Button Content="+"
            Style="{StaticResource QtyButtonStyle}"
            Click="Tang_SoLuong_Mon"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="0.2*"/>
