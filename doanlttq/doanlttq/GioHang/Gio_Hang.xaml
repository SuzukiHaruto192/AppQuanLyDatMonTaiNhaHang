                            <GradientStop Color="#F09819" Offset="1.0"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="2" 
                          Direction="320" 
                          Color="Gray" 
                          Opacity="0.3" 
                          BlurRadius="5"/>
                    </TextBlock.Effect>

                </TextBlock>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                      Direction="315" 
                                      BlurRadius="10"
                                      Opacity="0.4"/>


                </Border.Effect>
            </Border>
        </Grid>
        <Canvas x:Name="Canvas_Animation">

        </Canvas>
    </Grid>
</Window>
