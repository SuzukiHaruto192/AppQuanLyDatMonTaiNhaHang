<Window x:Class="doanlttq.Gio_Hang"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:doanlttq"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Gio_Hang" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="QtyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="QtyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="6">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- Hover -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7A00"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF7A00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FoodToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="White"
                   CornerRadius="12"
                   BorderBrush="#E0E0E0"
                   BorderThickness="1"
                   Padding="12"
                   Width="280"
                   Margin="10">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="4" BlurRadius="15" Opacity="0.2" Direction="315"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,0,10" Height="150"  >
                                    <Border.Background>
                                        <ImageBrush  ImageSource="{Binding ANH}"  Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TENMON}" FontWeight="Bold" FontSize="16" 
                                  TextWrapping="Wrap" Foreground="#333"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GIA, StringFormat={}{0:N0} đ}" 
                                  FontWeight="Bold" FontSize="16" Foreground="#FF7A00" Margin="10,0,0,0"/>
                                </Grid>

                                <Separator Grid.Row="2" Margin="0,8" Background="#F0F0F0"/>

                                <TextBlock Grid.Row="3" Text="{Binding MOTA}" 
                              FontSize="13" Foreground="#666" 
                              TextWrapping="Wrap" FontStyle="Italic"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>
        <Style x:Name="ButtonStyle"
             TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="BorderBrush" Value="#FF7A00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFA500"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC6600"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#00FFA500"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="2,8,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            >
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid RenderTransformOrigin="0.5,0.5">

            <Rectangle Fill="#FFA500"/>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" Grid.Column="1"
                    Grid.Row="1"
                    CornerRadius="20,20,0,0"
                    BorderBrush="#CC8400"
                    BorderThickness="2,0,2,2"
                            Effect="{DynamicResource DropShadow}">
                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                </Border.Resources>
            </Border>


        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Rectangle Fill="#FFA500"/>


        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="18*"/>
            </Grid.RowDefinitions>
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE71E;"
                       Grid.Column="1"
                       Grid.Row="1"
                        Padding="10,20,0,0"
                       Foreground="White"
                       />
            <TextBlock Text="Tìm Kiếm" 
                       Grid.Column="2"
                       Foreground="White"
                     Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Padding="10,8,0,0"/>


            <TextBox Grid.Column="2"
                     Grid.Row="1"
                x:Name="Textbox_TimKiem" 
                     TextChanged="Textbox_TimKiem_TextChanged"
                     
                        />
            <Button Grid.Column="4"
                    Grid.Row="1"
                    FontSize="17"
                    Content="Tìm Kiếm"
                    Click="Tim_Kiem_Mon_An"
                    
                    >
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                      Direction="315" 
                                      BlurRadius="10"
                                      Opacity="0.4"/>
                </Button.Effect>

            </Button>



        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="0.25*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="18*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="1"
                    Grid.Column="1"
                    FontSize="18"
                    Content="Hoá Đơn"
                    Click="Thanh_Toan_Click"
                    >
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                      Direction="315" 
                                      BlurRadius="10"
                                      Opacity="0.4"/>
                </Button.Effect>
            </Button>


            <Button Grid.Row="1"
                    Grid.Column="3"
                    Background="White"
                    FontSize="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="🛒"
                    Foreground="#FFF75F2B"
                    Click="Gio_Hang_Click"
                    x:Name="bnt_GH"
                    >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                                    >
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>

        <Grid x:Name="MenuGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition Height="0.705*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Column="1"
                    Grid.Row="1"
                    Content="Khai Vị"
                    FontSize="18"
                    Foreground="#FFA500"
                    Click="Click_Menu"
                    Background="White">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                                Background="{TemplateBinding Background}"
                                CornerRadius="10,10,0,0"
                                >
                            <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="2"
         Grid.Row="1"
         Content="Món Chính"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button
         Grid.Column="3"
         Grid.Row="1"
         Content="Đồ Ăn Kèm"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="4"
         Grid.Row="1"
         Content="Nước Uống"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="5"
         Grid.Row="1"
         Content="Tráng Miệng"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="6"
         Grid.Row="1"
         Content="Combo"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*"/>
                <ColumnDefinition Width="1.9*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.1*"/>
            </Grid.ColumnDefinitions>

         <!--   <ScrollViewer Grid.Row="1"
                          Grid.Column="1"
              VerticalScrollBarVisibility="Hidden"
              HorizontalScrollBarVisibility="Disabled"
