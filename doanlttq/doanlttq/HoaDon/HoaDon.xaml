<Window x:Class="doanlttq.HoaDon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:doanlttq"
        mc:Ignorable="d"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Title="HoaDon" Height="450" Width="800">
    <Window.Resources>
        <Style x:Name="ButtonStyle"
             TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="BorderBrush" Value="#FF7A00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFA500"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC6600"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid>
            <Rectangle Fill="#FFA500">
                
            </Rectangle>

        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Background="White" Grid.Column="1"
                    Grid.Row="1"
                    CornerRadius="20,20,20,20"
                    BorderBrush="#CC8400"
                    BorderThickness="2"
                            Effect="{DynamicResource DropShadow}">
                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                </Border.Resources>
            </Border>

        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="10*"/>

                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="1" Grid.Row="1" 
        Background="White" 
        CornerRadius="10" 
        Margin="10" 
        Padding="15"
        Effect="{DynamicResource DropShadow}">

                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Padding" Value="5,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFF5E6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFE8D1"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#888"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border BorderThickness="0,0,0,2" BorderBrush="#FFE86106" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="HÓA ĐƠN" 
                   FontSize="40" 
                   HorizontalAlignment="Center" 
                   Foreground="#FFE86106" 
                   FontWeight="Heavy"
                   Margin="0,0,0,20"/>

                    <ListView Grid.Row="1" x:Name="List_View" 
                  ItemsSource="{Binding Foods}" 
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn  Width="300" >
                                    <GridViewColumnHeader FontSize="24">
                                        TÊN MÓN
                                    </GridViewColumnHeader>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TENMON}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="20"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn  Width="200">
                                    <GridViewColumnHeader FontSize="24" HorizontalContentAlignment="Center">
                                        SỐ LƯỢNG
                                    </GridViewColumnHeader>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SoLuong}" HorizontalAlignment="Center" FontSize="20"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn  Width="150">
                                    <GridViewColumnHeader FontSize="24" HorizontalContentAlignment="Center">
                                        ĐƠN GIÁ
                                    </GridViewColumnHeader>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GIA, StringFormat={}{0:N0} đ}" FontSize="20"
                                           HorizontalAlignment="Right" 
                                           Foreground="#FFE86106"
                                           FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn  Width="270">
                                    <GridViewColumnHeader FontSize="24" HorizontalContentAlignment="Right">
                                        THÀNH TIỀN
                                    </GridViewColumnHeader>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding THANHTIEN, StringFormat={}{0:N0} đ}" FontSize="20"
                                           HorizontalAlignment="Right" 
                                           Foreground="#FFE86106"
                                           FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Border BorderThickness="0,1,0,0" BorderBrush="#DDD" Margin="0,0,0,10"/>

                        <DockPanel x:Name="dp_Voucher" LastChildFill="False" MouseLeftButtonUp="dp_Voucher_MouseLeftButtonUp">
                            <TextBlock Text="ĐỔI VOUCHER" FontSize="15" FontWeight="Bold" Foreground="#555"/>
                            <TextBlock x:Name="Voucher_Giam" FontSize="15" FontWeight="Bold" Foreground="#FFE86106" DockPanel.Dock="Right" Width="800" TextAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                        <Border BorderThickness="0,1,0,0" BorderBrush="#DDD" Margin="0,0,0,10"/>

                        <DockPanel LastChildFill="False">
                            <TextBlock Text="TỔNG CỘNG:" FontSize="18" FontWeight="Bold" Foreground="#555"/>
                            <TextBlock x:Name="Tong_Tien"
                                Text="0 VNĐ" 
                           DockPanel.Dock="Right"
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#FFE86106"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="0.35*"/>
            </Grid.RowDefinitions>
            <Button Grid.Column="1"
                    Grid.Row="2" 
                    Content="Chuyển Khoản"
                    FontSize="25"
                    Click="Thanh_Toan">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                      Direction="315" 
                                      BlurRadius="10"
                                      Opacity="0.4"/>
                </Button.Effect>

            </Button>
            <Button Grid.Column="3"
                    Grid.Row="2" 
                    Content="Tiền Mặt"
                    FontSize="25" Click="Tien_Mat">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                      Direction="315" 
                                      BlurRadius="10"
                                      Opacity="0.4"/>
                </Button.Effect>

            </Button>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.15*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Button Grid.Column="1"
                    Grid.Row="1" 
                    Content="Quay Lại"
                    FontSize="20"
                    Click="Quay_Lai">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="5"
                                      Direction="315" 
                                      BlurRadius="10"
                                      Opacity="0.4"/>
                </Button.Effect>
            </Button>
        </Grid>
    </Grid>
</Window>
