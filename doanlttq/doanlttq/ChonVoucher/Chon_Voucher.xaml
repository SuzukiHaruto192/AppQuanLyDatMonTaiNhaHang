<Window x:Class="doanlttq.ChonVoucher.Chon_Voucher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:doanlttq.ChonVoucher"
        mc:Ignorable="d"
        Title="Đổi Voucher" Height="1000" Width="1500"
        WindowStartupLocation="CenterOwner" WindowState="Maximized">
    <Window.Resources>
        <Style x:Name="ButtonStyle"
         TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="BorderBrush" Value="#FF7A00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="10,5"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFA500"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC6600"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid>
            <Rectangle Fill="#FFA500">

            </Rectangle>

        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Background="White" Grid.Column="1"
                Grid.Row="1"
                CornerRadius="20,20,20,20"
                BorderBrush="#CC8400"
                BorderThickness="2"
                        Effect="{DynamicResource DropShadow}">
                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.3" />
                </Border.Resources>
            </Border>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="4*"/>

                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="1" Grid.Row="1" 
    Background="White" 
    CornerRadius="10" 
    Margin="10" 
    Padding="15"
    Effect="{DynamicResource DropShadow}">

                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                          BlurRadius="8"
                                          ShadowDepth="2"
                                          Opacity="0.3" />
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Padding" Value="5,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFF5E6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FFE8D1"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#888"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border BorderThickness="0,0,0,2" BorderBrush="#FFE86106" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0.5*"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VOUCHER" 
               FontSize="40" 
               HorizontalAlignment="Center" 
               Foreground="#FFE86106" 
               FontWeight="Heavy"
               Margin="0,0,0,5"/>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="ĐIỂM TÍCH LŨY:" DockPanel.Dock="Left" FontSize="20" Foreground="#FFE86106" FontWeight="Bold"/>
                        <TextBlock x:Name="DiemTL" Text="30" DockPanel.Dock="Right" TextAlignment="Right" FontSize="20" Foreground="#FFE86106" FontWeight="Bold"/>
                    </DockPanel>

                    <ListView x:Name="lv_Vouchers" ItemsSource="{Binding Vouchers}"  Grid.Row="2"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent" Margin="3,10,3,3">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                Background="White"
                                CornerRadius="12"
                                BorderBrush="#E0E0E0"
                                BorderThickness="3"
                                Margin="0,0,0,12">
                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#FFE86106"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border 
                    CornerRadius="12"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Background="White">

                                    <Grid Height="100">
                                        <Grid.Style>
                                            <Style/>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Phần giảm giá (trái) -->
                                        <Border Grid.Column="0"
                                        Background="#FFA500"
                                            CornerRadius="12,0,0,12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="GIẢM"
                                                    Foreground="Black"
                                                    FontSize="16"
                                                    HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding GiaTriGiam, StringFormat={}{0:N0}}"
                                       Foreground="Black"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                                                <TextBlock Text="VNĐ"
                                                    Foreground="Black"
                                                    FontSize="16"
                                                    HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Nội dung voucher -->
                                        <Grid Grid.Column="1" Margin="5,5,5,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding TenVoucher}"
                                   FontWeight="SemiBold"
                                   FontSize="24"/>

                                            <TextBlock Text="{Binding GiaTriToiThieu, StringFormat={}Hóa đơn tối thiểu {0:N0} VNĐ}"
                                   Grid.Row="1"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding SoDiem, StringFormat={}Dùng {0} điểm tích lũy}"
                                   Grid.Row="2"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>

                                            <DockPanel Grid.Row="2"
                                   Margin="0,8,0,0">
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="0.25*"/>
            </Grid.RowDefinitions>

            <Button Grid.Column="1"
                Grid.Row="2" 
                Content="Áp Dụng"
                FontSize="25" Click="Ap_Dung" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.15*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Button Grid.Column="1"
                Grid.Row="1" 
                Content="Quay Lại"
                FontSize="20"
                Click="Quay_Lai">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
