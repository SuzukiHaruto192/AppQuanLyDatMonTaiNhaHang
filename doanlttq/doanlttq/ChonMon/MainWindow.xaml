<Window x:Class="doanlttq.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:doanlttq"
		mc:Ignorable="d"
        WindowState="Maximized"
        
        ResizeMode="NoResize"
		Title="ĐỒ ÁN LẬP TRÌNH TRỰC QUAN" Height="600" Width="1000">
    <Window.Resources>
        <Style TargetType="ListView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>
        <Style x:Name="ButtonStyle"
             TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF7A00"/>
            <Setter Property="BorderBrush" Value="#FF7A00"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFA500"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC6600"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#00FFA500"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="2,8,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            >
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"/>
                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid RenderTransformOrigin="0.5,0.5">

            <Rectangle Fill="#FFA500"/>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" Grid.Column="1"
                    Grid.Row="1"
                    CornerRadius="20,20,0,0"
                    BorderBrush="#CC8400"
                    BorderThickness="2"
                            Effect="{DynamicResource DropShadow}">
                <Border.Resources>
                    <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                </Border.Resources>
            </Border>


        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Rectangle Fill="#FFA500"/>


        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="18*"/>
            </Grid.RowDefinitions>
            <TextBlock FontFamily="Segoe MDL2 Assets"
                       Text="&#xE71E;"
                       Grid.Column="1"
                       Grid.Row="1"
                        Padding="10,20,0,0"
                       Foreground="White"
                       />
            <TextBlock Text="Tìm Kiếm" 
                       Grid.Column="2"
                       Foreground="White"
                     Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Padding="10,8,0,0"/>


            <TextBox Grid.Column="2"
                     Grid.Row="1"
                x:Name="Textbox_TimKiem" 
                     TextChanged="Textbox_TimKiem_TextChanged"
                     
                        />
            <Button Grid.Column="4"
                    Grid.Row="1"
                    FontSize="17"
                    Content="Tìm Kiếm"
                    Click="Tim_Kiem_Mon_An"
                    
                    >

            </Button>



        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="0.25*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="18*"/>
            </Grid.RowDefinitions>



            <Button Grid.Row="1"
                    Grid.Column="3"
                    Background="White"
                    FontSize="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="🛒"
                    Foreground="#FFF75F2B"
                    Click="Gio_Hang_Click"
                    >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                                    >
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>

        <Grid x:Name="MenuGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="0.83*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.3*"/>
                <RowDefinition Height="0.705*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Column="1"
                    Grid.Row="1"
                    Content="Khai Vị"
                    FontSize="18"
                    Foreground="#FFA500"
                    Click="Click_Menu"
                    Background="White">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                                Background="{TemplateBinding Background}"
                                CornerRadius="10,10,0,0"
                                >
                            <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="2"
         Grid.Row="1"
         Content="Món Chính"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button
         Grid.Column="3"
         Grid.Row="1"
         Content="Đồ Ăn Kèm"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="4"
         Grid.Row="1"
         Content="Nước Uống"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="5"
         Grid.Row="1"
         Content="Tráng Miệng"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
            <Button HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch"
         Grid.Column="6"
         Grid.Row="1"
         Content="Combo"
         FontSize="18"
         Foreground="White"
                    Click="Click_Menu"
                    Background="#FFA500">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border 
                     Background="{TemplateBinding Background}"
                                                            CornerRadius="10,10,0,0"
                     >
                            <ContentPresenter
                 Content="{TemplateBinding Content}"
                 ContentTemplate="{TemplateBinding ContentTemplate}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>
        </Grid>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*"/>
                <ColumnDefinition Width="2.9*"/>
                <ColumnDefinition Width="0.1*"/>
            </Grid.ColumnDefinitions>

            <!--<ScrollViewer Grid.Row="1"
                          Grid.Column="1"
              VerticalScrollBarVisibility="Hidden"
              HorizontalScrollBarVisibility="Disabled"
              >
                <ItemsControl ">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    -->
            <!-- Template hiển thị từng món -->
