            <ListView x:Name="lstMon" 
                      Grid.Row="1"
                      Grid.Column="1"
                  ItemsSource="{Binding Foods}"
                  Background="Transparent"
                  BorderThickness="0" SelectionChanged="lstMon_SelectionChanged"
                      >
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="170" Height="240"
                            Margin="10"
                            CornerRadius="12"
                            Background="White"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            Effect="{DynamicResource DropShadow}">
                            <Border.Resources>
                                <DropShadowEffect x:Key="DropShadow"
                                              BlurRadius="8"
                                              ShadowDepth="2"
                                              Opacity="0.3" />
                            </Border.Resources>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#FF7A00"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <Border                                   
        Width="160" 
        Height="140"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush  ImageSource="{Binding ANH}"/>
                                    </Border.Background>
                                </Border>


                                <TextBlock Text="{Binding TENMON}"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="#333"
                                       TextAlignment="Center"
                                       Margin="5,5,5,2"
                                       TextWrapping="Wrap" />

                                <TextBlock Text="{Binding GIA, StringFormat={}{0:N0} VNĐ}"
                                       Margin="5,2,5,3"
                                       FontSize="16"
                                       Foreground="#FF7A00"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
       

    </Grid>
</Window>
